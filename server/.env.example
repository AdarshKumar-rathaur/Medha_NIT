# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini API
# Add your Google Gemini API key below:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email Notification Service (Nodemailer)
# If left blank, the server automatically uses Ethereal Email test accounts 
# and provides real clickable preview URLs for all sent emails!
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Medha Decision Engine <offers@medha-ai.internal>"
